# Copy to .env.local. Leave both Supabase values empty to run on the local mock data.
# Project ref jofgoferdnkihimvencr -> https://jofgoferdnkihimvencr.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon (public) key only. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force the mock even when keys are set: DATA_SOURCE=mock
DATA_SOURCE=
# Mock replay cursor (week_idx 56..156). 91 = 2025-W26 (Urology ESBL outbreak), 130 = 2026-W13 (ICU MRSA cluster).
MOCK_CURSOR_WEEK=91
