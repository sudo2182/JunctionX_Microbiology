# Copy to .env for local runs (never commit .env). Values live in GitHub environment
# `supabase-prod` secrets (Actions) and Vercel env vars (web). Names only here.

# Supabase project ref: jofgoferdnkihimvencr  ->  https://jofgoferdnkihimvencr.supabase.co
SUPABASE_URL=
# Session pooler connection string (Project Settings -> Database -> Connection string -> Session pooler)
SUPABASE_DB_URL=
# Service role key: GitHub Actions only, never the browser or Vercel
SUPABASE_SERVICE_ROLE_KEY=

# migrate.yml (Supabase CLI)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=jofgoferdnkihimvencr

# Where the synthetic CSVs are (default: data/raw/, then TYKS_data/)
AMR_DATA_DIR=

# Deep links in RSS items
APP_BASE_URL=

# Local integration tests only: a throwaway Postgres the tests may wipe
TEST_DATABASE_URL=

# web/ (Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
