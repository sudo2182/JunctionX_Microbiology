# Every environment variable in this repo, grouped by where it goes. Names only — never commit real values.
# All .env files are git-ignored. Supabase project ref: jofgoferdnkihimvencr -> https://jofgoferdnkihimvencr.supabase.co

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env  — the dashboard app (local dev). On Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────
# Browser values, baked in at build time (public: the publishable key is safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server values (same Supabase URL / publishable key; used by /api/assistant to check the session)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Assistant (server only; never prefix with VITE_, which would ship it to browsers)
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# backend/.env  — only for running the Python pipeline on your laptop (export them in your shell; the
# pipeline reads real environment variables, it does not load a .env file itself).
# In GitHub Actions these come from the `supabase-prod` environment secrets.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
# Session pooler connection string (Project Settings -> Database -> Connection string -> Session pooler)
SUPABASE_DB_URL=
# Service role key: GitHub Actions / local pipeline only — never the frontend or Vercel
SUPABASE_SERVICE_ROLE_KEY=
# Where the synthetic CSVs are (default: data/raw/, then data/tyks/)
AMR_DATA_DIR=
# Deep links in RSS items (the deployed frontend URL)
APP_BASE_URL=
# Local integration tests only: a throwaway Postgres the tests may wipe
TEST_DATABASE_URL=
# Optional, only for running the Supabase CLI from a laptop
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=jofgoferdnkihimvencr

# archive/dashboard-nextjs/ (not deployed) has its own .env.example if you ever run it.
